{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "client.entry-unlock",
      "scope": "client",
      "title": "入口与解锁条件",
      "rolesAny": ["client"],
      "pathGlobsAny": ["**/*Entry*.*", "**/*Router*.*", "**/*Unlock*.*"],
      "requirementTermsAny": ["入口", "解锁", "开启条件", "开放条件"],
      "trigger": "any",
      "evidenceExpectation": "定位最终态入口注册，以及导航或激活前实际执行的解锁条件。",
      "notApplicableWhen": "需求不提供客户端入口，也没有解锁或开放规则。"
    },
    {
      "id": "client.ui-state",
      "scope": "client",
      "title": "界面状态",
      "rolesAny": ["client"],
      "pathGlobsAny": ["**/ui/**", "**/view/**", "**/*View*.*", "**/*Panel*.*"],
      "requirementTermsAny": ["界面", "UI", "按钮", "弹窗", "加载状态", "空状态"],
      "trigger": "any",
      "evidenceExpectation": "定位加载、可操作、空、成功和失败状态的控制器或视图模型绑定。",
      "notApplicableWhen": "需求没有界面或可见交互状态。"
    },
    {
      "id": "client.request-construction",
      "scope": "client",
      "title": "请求构造",
      "rolesAny": ["client"],
      "pathGlobsAny": ["**/*Request*.*", "**/net/**", "**/network/**", "**/protocol/**"],
      "requirementTermsAny": ["请求", "发送", "提交", "协议"],
      "trigger": "any",
      "evidenceExpectation": "定位调用点并核对消息或接口、字段名、值和序列化类型。",
      "notApplicableWhen": "需求不发送客户端请求。"
    },
    {
      "id": "client.response-push-handling",
      "scope": "client",
      "title": "响应与推送处理",
      "rolesAny": ["client"],
      "pathGlobsAny": ["**/*Response*.*", "**/*Push*.*", "**/*Notify*.*", "**/net/**"],
      "requirementTermsAny": ["响应", "推送", "返回结果", "下发", "通知"],
      "trigger": "any",
      "evidenceExpectation": "定位处理器注册及消费相关响应或推送结果的分支。",
      "notApplicableWhen": "流程没有响应体，也没有服务端推送。"
    },
    {
      "id": "client.local-cache",
      "scope": "client",
      "title": "本地缓存",
      "rolesAny": ["client"],
      "pathGlobsAny": ["**/*Cache*.*", "**/*Storage*.*", "**/*Preference*.*", "**/*Persist*.*"],
      "requirementTermsAny": ["缓存", "本地保存", "本地存储", "持久化到客户端"],
      "trigger": "any",
      "evidenceExpectation": "定位缓存读、写、失效点，以及持久化的键或模型。",
      "notApplicableWhen": "客户端不缓存该状态。"
    },
    {
      "id": "client.reconnect",
      "scope": "client",
      "title": "重连恢复",
      "rolesAny": ["client"],
      "pathGlobsAny": ["**/*Reconnect*.*", "**/*Connection*.*", "**/*Session*.*"],
      "requirementTermsAny": ["重连", "断线", "重新连接", "恢复状态"],
      "trigger": "any",
      "evidenceExpectation": "定位重连后的重新订阅、状态刷新或恢复路径。",
      "notApplicableWhen": "功能没有跨会话或依赖推送的状态。"
    },
    {
      "id": "client.localization",
      "scope": "client",
      "title": "本地化",
      "rolesAny": ["client"],
      "evidenceRoles": ["client", "config"],
      "pathGlobsAny": ["**/*Localization*.*", "**/*Locale*.*", "**/*I18n*.*", "**/*Language*.*"],
      "requirementTermsAny": ["本地化", "多语言", "文案", "翻译", "语言包"],
      "trigger": "any",
      "evidenceExpectation": "定位界面查找调用，并核对正式本地化键和值。",
      "notApplicableWhen": "客户端不展示用户可见文本。"
    },
    {
      "id": "client.error-presentation",
      "scope": "client",
      "title": "错误呈现",
      "rolesAny": ["client"],
      "pathGlobsAny": ["**/*Error*.*", "**/*Exception*.*", "**/*Toast*.*", "**/*Tip*.*"],
      "requirementTermsAny": ["错误", "失败", "异常", "错误提示", "失败提示"],
      "trigger": "any",
      "evidenceExpectation": "定位服务端或本地失败到可见状态、提示或消息的映射。",
      "notApplicableWhen": "操作不会产生用户可见失败。"
    },
    {
      "id": "server.authority",
      "scope": "server",
      "title": "服务端权威性",
      "rolesAny": ["server"],
      "pathGlobsAny": ["**/*Service*.*", "**/*Handler*.*", "**/*Manager*.*", "**/*Reward*.*"],
      "requirementTermsAny": ["权威", "结算", "奖励", "计算", "发放", "扣除"],
      "trigger": "any",
      "evidenceExpectation": "定位状态变更或奖励前由服务端完成的权威判定或计算。",
      "notApplicableWhen": "需求仅改变表现，不改变任何权威状态。"
    },
    {
      "id": "server.permission",
      "scope": "server",
      "title": "权限校验",
      "rolesAny": ["server"],
      "pathGlobsAny": ["**/*Permission*.*", "**/*Auth*.*", "**/*Access*.*", "**/*Handler*.*"],
      "requirementTermsAny": ["权限", "身份", "角色限制", "资格", "可操作"],
      "trigger": "any",
      "evidenceExpectation": "定位操作前对调用者身份、角色或状态的门禁。",
      "notApplicableWhen": "操作明确公开且与身份无关。"
    },
    {
      "id": "server.parameter-validation",
      "scope": "server",
      "title": "参数校验",
      "rolesAny": ["server"],
      "pathGlobsAny": ["**/*Validator*.*", "**/*Validation*.*", "**/*Request*.*", "**/*Handler*.*"],
      "requirementTermsAny": ["参数", "范围", "合法性", "所有权", "类型校验"],
      "trigger": "any",
      "evidenceExpectation": "定位请求输入的范围、存在性、所有权和类型检查。",
      "notApplicableWhen": "处理器不接收调用者可控参数。"
    },
    {
      "id": "server.state-transition",
      "scope": "server",
      "title": "状态流转",
      "rolesAny": ["server"],
      "pathGlobsAny": ["**/*State*.*", "**/*Status*.*", "**/*Machine*.*", "**/*Handler*.*"],
      "requirementTermsAny": ["状态", "流转", "阶段", "变更为", "转换"],
      "trigger": "any",
      "evidenceExpectation": "定位带前置守卫的状态赋值，并核对允许的前后状态。",
      "notApplicableWhen": "需求不改变服务端状态。"
    },
    {
      "id": "server.persistence",
      "scope": "server",
      "title": "持久化",
      "rolesAny": ["server"],
      "pathGlobsAny": ["**/*Repository*.*", "**/*Dao*.*", "**/*Storage*.*", "**/*Persistence*.*"],
      "requirementTermsAny": ["持久化", "存档", "数据库", "保存", "落库", "重载"],
      "trigger": "any",
      "evidenceExpectation": "定位状态的存储读写映射以及重载路径。",
      "notApplicableWhen": "状态明确为临时状态。"
    },
    {
      "id": "server.time-boundary",
      "scope": "server",
      "title": "重置与时间边界",
      "rolesAny": ["server"],
      "pathGlobsAny": ["**/*Timer*.*", "**/*Time*.*", "**/*Reset*.*", "**/*Expire*.*", "**/*Schedule*.*"],
      "requirementTermsAny": ["重置", "过期", "时间窗口", "时区", "截止时间", "刷新时间"],
      "trigger": "any",
      "evidenceExpectation": "定位重置调度或边界计算，并核对单位和时区。",
      "notApplicableWhen": "需求没有重置、过期或时间窗口。"
    },
    {
      "id": "server.idempotence",
      "scope": "server",
      "title": "幂等性",
      "rolesAny": ["server"],
      "pathGlobsAny": ["**/*Idempotent*.*", "**/*Dedup*.*", "**/*Transaction*.*", "**/*Handler*.*"],
      "requirementTermsAny": ["幂等", "重复请求", "重复领取", "重复提交", "防重"],
      "trigger": "any",
      "evidenceExpectation": "定位防重令牌、先前状态守卫或重复执行仍安全的证明。",
      "notApplicableWhen": "操作只读，或明确允许重复执行。"
    },
    {
      "id": "server.concurrency",
      "scope": "server",
      "title": "并发控制",
      "rolesAny": ["server"],
      "pathGlobsAny": ["**/*Lock*.*", "**/*Transaction*.*", "**/*Concurrent*.*", "**/*Atomic*.*"],
      "requirementTermsAny": ["并发", "竞态", "锁", "原子", "事务", "同时操作"],
      "trigger": "any",
      "evidenceExpectation": "定位变更点的事务、锁、比较交换或串行所有权。",
      "notApplicableWhen": "没有竞争写入能作用于同一状态。"
    },
    {
      "id": "server.response",
      "scope": "server",
      "title": "响应构造",
      "rolesAny": ["server"],
      "pathGlobsAny": ["**/*Response*.*", "**/*Reply*.*", "**/*Handler*.*", "**/protocol/**"],
      "requirementTermsAny": ["响应", "返回", "返回值", "错误码", "协议"],
      "trigger": "any",
      "evidenceExpectation": "定位响应构造，并核对状态、字段、类型和错误分支。",
      "notApplicableWhen": "服务端操作没有请求响应契约。"
    },
    {
      "id": "config.formal-xlsx-row",
      "scope": "config",
      "title": "正式 Excel 配置行",
      "rolesAny": ["config"],
      "pathGlobsAny": ["*.xlsx", "**/*.xlsx"],
      "requirementTermsAny": ["配置表", "配置行", "Excel", "xlsx"],
      "trigger": "any",
      "evidenceExpectation": "在按提交提取的正式工作簿中定位对应行和主键。",
      "notApplicableWhen": "需求明确不由配置驱动。"
    },
    {
      "id": "config.header-consumer",
      "scope": "config",
      "title": "c/s/cs 表头与消费端",
      "rolesAny": ["config"],
      "evidenceRoles": ["config", "client", "server"],
      "pathGlobsAny": ["*.xlsx", "**/*.xlsx"],
      "requirementTermsAny": ["c/s/cs", "表头", "客户端读取", "服务端读取", "消费端"],
      "trigger": "all",
      "evidenceExpectation": "核对 c、s 或 cs 标记与实际读取该字段的客户端或服务端代码一致。",
      "notApplicableWhen": "工作簿对该字段没有消费端表头约定。"
    },
    {
      "id": "config.type-ext-schema",
      "scope": "config",
      "title": "type/ext 结构",
      "rolesAny": ["config"],
      "evidenceRoles": ["config", "client", "server"],
      "pathGlobsAny": ["*.xlsx", "**/*.xlsx", "**/*Schema*.*"],
      "requirementTermsAny": ["type", "ext", "字段类型", "数组结构", "对象结构"],
      "trigger": "all",
      "evidenceExpectation": "核对正式表头或结构单元格与消费者解析的标量、对象或数组形状一致。",
      "notApplicableWhen": "检查行没有新增带类型或扩展结构的字段。"
    },
    {
      "id": "config.override",
      "scope": "config",
      "title": "root/custom 覆盖",
      "rolesAny": ["config"],
      "evidenceRoles": ["config", "client", "server"],
      "pathGlobsAny": ["**/root/**", "**/custom/**", "*.xlsx", "**/*.xlsx"],
      "requirementTermsAny": ["root", "custom", "覆盖", "优先级", "合并"],
      "trigger": "all",
      "evidenceExpectation": "定位覆盖行或来源，并核对最终态的优先级或合并行为。",
      "notApplicableWhen": "该表不可被覆盖。"
    },
    {
      "id": "config.foreign-keys",
      "scope": "config",
      "title": "外键关系",
      "rolesAny": ["config"],
      "evidenceRoles": ["config", "client", "server"],
      "pathGlobsAny": ["*.xlsx", "**/*.xlsx", "**/*Relation*.*"],
      "requirementTermsAny": ["外键", "引用表", "关联ID", "关联 ID", "引用字段"],
      "trigger": "all",
      "evidenceExpectation": "核对被引用表和主键存在，并确认消费者使用同一关系。",
      "notApplicableWhen": "配置行不包含外部引用。"
    },
    {
      "id": "config.defaults",
      "scope": "config",
      "title": "配置默认值",
      "rolesAny": ["config"],
      "evidenceRoles": ["config", "client", "server"],
      "pathGlobsAny": ["*.xlsx", "**/*.xlsx", "**/*Config*.*"],
      "requirementTermsAny": ["默认值", "缺省", "为空时", "未配置时"],
      "trigger": "all",
      "evidenceExpectation": "核对正式默认值单元格及字段缺失时的消费端行为。",
      "notApplicableWhen": "字段必填且没有默认语义。"
    },
    {
      "id": "config.enum",
      "scope": "config",
      "title": "配置枚举",
      "rolesAny": ["config"],
      "evidenceRoles": ["config", "client", "server"],
      "pathGlobsAny": ["*.xlsx", "**/*.xlsx", "**/*Enum*.*"],
      "requirementTermsAny": ["枚举", "枚举值", "状态值", "类型值"],
      "trigger": "all",
      "evidenceExpectation": "定位正式枚举值，并核对客户端或服务端符号与数值。",
      "notApplicableWhen": "字段不使用枚举。"
    },
    {
      "id": "config.localization-key",
      "scope": "config",
      "title": "配置本地化键",
      "rolesAny": ["config"],
      "pathGlobsAny": ["*.xlsx", "**/*.xlsx", "**/*Language*.*", "**/*Locale*.*"],
      "requirementTermsAny": ["本地化键", "LcKey", "多语言键", "文案键"],
      "trigger": "all",
      "evidenceExpectation": "核对正式键引用及匹配的本地化条目。",
      "notApplicableWhen": "配置内容不展示为用户可见文本。"
    },
    {
      "id": "config.exported-json",
      "scope": "config",
      "title": "导出 JSON",
      "rolesAny": ["config"],
      "pathGlobsAny": ["*.json", "**/*.json"],
      "requirementTermsAny": ["导表", "导出 JSON", "生成 JSON", "导出数据"],
      "trigger": "any",
      "evidenceExpectation": "核对生成行与正式工作簿的主键、字段和值一致。",
      "notApplicableWhen": "该工作簿不导出为 JSON。"
    },
    {
      "id": "cross.protocol-fields-types",
      "scope": "cross-end",
      "title": "协议字段与类型一致性",
      "rolesAll": ["client", "server"],
      "pathGlobsAny": ["**/protocol/**", "**/*Request*.*", "**/*Response*.*", "**/*Message*.*"],
      "requirementTermsAny": ["协议", "请求字段", "响应字段", "字段类型", "可选字段"],
      "trigger": "any",
      "evidenceExpectation": "核对客户端构造、协议声明和服务端解析的字段名、可选性与类型。",
      "notApplicableWhen": "需求不涉及客户端与服务端消息。"
    },
    {
      "id": "cross.enum-values",
      "scope": "cross-end",
      "title": "跨端枚举值",
      "rolesAll": ["client", "server"],
      "evidenceRoles": ["client", "server", "config"],
      "pathGlobsAny": ["**/*Enum*.*", "**/protocol/**"],
      "requirementTermsAny": ["枚举", "状态值", "类型值", "错误码"],
      "trigger": "any",
      "evidenceExpectation": "核对客户端、服务端、协议及相关配置使用相同语义和数值。",
      "notApplicableWhen": "需求没有跨端枚举。"
    },
    {
      "id": "cross.ids",
      "scope": "cross-end",
      "title": "跨端 ID",
      "rolesAll": ["client", "server"],
      "evidenceRoles": ["client", "server", "config"],
      "pathGlobsAny": ["**/protocol/**", "**/*Request*.*", "**/*Response*.*", "**/*Config*.*"],
      "requirementTermsAny": ["ID", "Id", "标识", "主键", "编号"],
      "trigger": "any",
      "evidenceExpectation": "核对生产者、消费者和正式配置使用同一标识及查找域。",
      "notApplicableWhen": "没有标识跨越端边界。"
    },
    {
      "id": "cross.defaults",
      "scope": "cross-end",
      "title": "跨端默认语义",
      "rolesAll": ["client", "server"],
      "evidenceRoles": ["client", "server", "config"],
      "pathGlobsAny": ["**/protocol/**", "**/*Config*.*", "**/*Request*.*", "**/*Response*.*"],
      "requirementTermsAny": ["默认值", "缺省", "为空时", "未传时", "可选字段"],
      "trigger": "any",
      "evidenceExpectation": "核对每一端对字段缺失使用相同默认行为。",
      "notApplicableWhen": "字段始终存在且没有默认值。"
    },
    {
      "id": "cross.ownership",
      "scope": "cross-end",
      "title": "跨端权威归属",
      "rolesAll": ["client", "server"],
      "pathGlobsAny": ["**/*Service*.*", "**/*Manager*.*", "**/*Controller*.*", "**/*Model*.*"],
      "requirementTermsAny": ["权威", "归属", "服务端计算", "客户端计算", "同步状态"],
      "trigger": "any",
      "evidenceExpectation": "确认唯一权威所有者，并定位其他端消费其结果的路径。",
      "notApplicableWhen": "需求只存在于一个端。"
    },
    {
      "id": "cross.request-response-push-closure",
      "scope": "cross-end",
      "title": "请求响应推送闭环",
      "rolesAll": ["client", "server"],
      "pathGlobsAny": ["**/*Request*.*", "**/*Response*.*", "**/*Push*.*", "**/*Notify*.*", "**/protocol/**"],
      "requirementTermsAny": ["请求", "响应", "推送", "返回结果", "下发"],
      "trigger": "any",
      "evidenceExpectation": "定位请求触发、服务端处理、响应或推送以及客户端消费的完整链路。",
      "notApplicableWhen": "交互不基于请求、响应或推送。"
    },
    {
      "id": "cross.time-units-time-zones",
      "scope": "cross-end",
      "title": "跨端时间单位与时区",
      "rolesAll": ["client", "server"],
      "pathGlobsAny": ["**/*Time*.*", "**/*Date*.*", "**/*Timer*.*", "**/protocol/**"],
      "requirementTermsAny": ["时间戳", "毫秒", "秒", "时区", "UTC", "重置时间", "截止时间"],
      "trigger": "any",
      "evidenceExpectation": "核对字段声明与转换使用相同单位、纪元或边界和时区。",
      "notApplicableWhen": "没有时间值或边界跨越端。"
    },
    {
      "id": "cross.missing-end",
      "scope": "cross-end",
      "title": "缺失端检查",
      "rolesAll": ["client", "server"],
      "evidenceRoles": ["client", "server", "config"],
      "pathGlobsAny": ["**/*Request*.*", "**/*Response*.*", "**/*Handler*.*", "**/*Config*.*"],
      "requirementTermsAny": ["客户端", "服务端", "配置", "跨端", "缺失端"],
      "trigger": "any",
      "evidenceExpectation": "将需求矩阵预期与最终态证据对齐，确认每个必需端都有实现。",
      "notApplicableWhen": "文档和架构只要求当前已经举证的端。"
    }
  ]
}
